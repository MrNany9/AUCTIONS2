# Database (SQLite for dev; swap for a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth session signing secret (change in production!)
AUTH_SECRET="change-me-to-a-long-random-secret-string-in-production"

# SMTP for debt-reminder emails (optional).
# When unset, emails are recorded in the notifications log as SIMULATED.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# SMTP_FROM="vaad@example.com"
