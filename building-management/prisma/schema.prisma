// מערכת ניהול ועד בית - Prisma schema
// SQLite for development. To move to Postgres, change provider to "postgresql"
// and update DATABASE_URL. SQLite has no native enums, so statuses/roles are
// stored as validated strings (see src/lib/enums.ts for the allowed values).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// חשבונות משתמשים - תפקידים: ADMIN | COMMITTEE | RESIDENT
model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         String     @default("RESIDENT")
  buildingId   String? // עבור ועד בניין - הבניין שבאחריותו
  building     Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  resident     Resident? // עבור דייר - הדייר המקושר
  createdAt    DateTime   @default(now())
}

// בניין
model Building {
  id                 String     @id @default(cuid())
  name               String
  address            String
  city               String
  numUnits           Int        @default(0)
  floors             Int? // מספר קומות
  monthlyFeePerUnit  Float      @default(0) // דמי ועד חודשיים לדירה (₪)
  active             Boolean    @default(true) // בניין פעיל
  activeSince        DateTime? // תחילת פעילות מול הבניין
  contractStart      DateTime? // חוזה ניהול - תחילה
  contractEnd        DateTime? // חוזה ניהול - סיום (התראת חידוש)
  contractor         String? // קבלן הבניין
  notes              String?
  createdAt          DateTime   @default(now())

  units            Unit[]
  residents        Resident[]
  charges          Charge[]
  maintenance      MaintenanceRequest[]
  expenses         Expense[]
  users            User[]
  schedules        MaintenanceSchedule[]
  contracts        SupplierContract[]
  announcements    Announcement[]
  serviceProviders BuildingSupplier[]
}

// מדריך ספקי הבניין לפי תחום (חשמלאי, אינסטלטור, מעליות, גז...)
model BuildingSupplier {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  trade      String // תחום: ELECTRICIAN | PLUMBER | ELEVATOR | GAS | FIRE | INTERCOM...

  @@unique([buildingId, supplierId, trade])
}

// דירה / יחידה
model Unit {
  id         String     @id @default(cuid())
  buildingId String
  building   Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  number     String // מספר דירה
  floor      Int?
  size       Float? // מ"ר
  residents  Resident[]

  @@unique([buildingId, number])
}

// דייר
model Resident {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName         String
  phone            String?
  phone2           String? // טלפון נוסף
  email            String?
  idNumber         String? // ת.זהות
  isOwner          Boolean  @default(true) // בעלים או שוכר
  isCommitteeRep   Boolean  @default(false) // נציג ועד הבית
  collectionStatus String   @default("NONE") // NONE | LAWYER | EXECUTION | COLLECTION
  leaseStart       DateTime? // חוזה שכירות - לשוכר
  leaseEnd         DateTime?
  standingOrder    Boolean  @default(false) // הוראת קבע
  chargeDay        Int? // יום חיוב בחודש
  moveInDate       DateTime @default(now())
  moveOutDate      DateTime? // תאריך עזיבה (בהחלפת דייר)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  charges  Charge[]
  payments Payment[]
  requests MaintenanceRequest[]
  logs     ResidentLog[]
}

// יומן דייר - שיחות, מכתבים, הערות
model ResidentLog {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  kind       String   @default("CALL") // CALL | LETTER | SMS | EMAIL | NOTE
  content    String
  createdBy  String? // שם המשתמש שרשם
  createdAt  DateTime @default(now())
}

// דרישת תשלום - type: MONTHLY_FEE | SPECIAL | FINE
// status: OPEN | PARTIAL | PAID | OVERDUE
model Charge {
  id          String    @id @default(cuid())
  buildingId  String
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residentId  String
  resident    Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type        String    @default("MONTHLY_FEE")
  amount      Float
  dueDate     DateTime
  period      String? // YYYY-MM עבור דמי ועד חודשיים
  description String?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())

  payments Payment[]
}

// תשלום - method: CASH | TRANSFER | CHECK | ONLINE
model Payment {
  id         String    @id @default(cuid())
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  chargeId   String?
  charge     Charge?   @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  amount     Float
  date       DateTime  @default(now())
  method     String    @default("TRANSFER")
  reference  String? // אסמכתא / מספר קבלה
  note       String?
  createdAt  DateTime  @default(now())
}

// קריאת תיקון / תחזוקה
// category: ELEVATOR | PLUMBING | ELECTRICITY | CLEANING | GARDEN | STRUCTURE | OTHER
// priority: LOW | MED | HIGH | URGENT
// status: OPEN | IN_PROGRESS | RESOLVED | CLOSED
model MaintenanceRequest {
  id                 String    @id @default(cuid())
  buildingId         String
  building           Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  reportedById       String?
  reportedBy         Resident? @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  scheduleId         String? // אם נוצרה מתוכנית תחזוקה מונעת
  schedule           MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  location           String? // מיקום בבניין (לובי, חניון, קומה 2...)
  receivedBy         String? // מי קיבל את הקריאה
  reporterPhone      String? // טלפון מוסר הקריאה
  recurring          Boolean   @default(false) // תקלה חוזרת
  billTo             String    @default("COMMITTEE") // COMMITTEE | RESIDENT | BUILDING | NONE
  category           String    @default("OTHER")
  priority           String    @default("MED")
  status             String    @default("OPEN")
  assignedSupplierId String?
  assignedSupplier   Supplier? @relation(fields: [assignedSupplierId], references: [id], onDelete: SetNull)
  cost               Float?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  expenses Expense[]
}

// ספק שירות
model Supplier {
  id        String   @id @default(cuid())
  name      String
  service   String // תחום שירות (חשמל, אינסטלציה, מעליות...)
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  requests  MaintenanceRequest[]
  expenses  Expense[]
  contracts SupplierContract[]
  schedules MaintenanceSchedule[]
  buildings BuildingSupplier[]
}

// תוכנית תחזוקה מונעת - מייצרת קריאות תיקון אוטומטית כשמגיע המועד
model MaintenanceSchedule {
  id              String    @id @default(cuid())
  buildingId      String
  building        Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  title           String // למשל: בדיקת בטיחות למעלית
  description     String?
  category        String    @default("OTHER")
  frequencyMonths Int // תדירות בחודשים (1, 3, 6, 12...)
  nextDueAt       DateTime // המועד הבא לביצוע
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  requests MaintenanceRequest[]
}

// חוזה שירות עם ספק - התראה לפני פקיעה
model SupplierContract {
  id          String    @id @default(cuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  description String // למשל: חוזה שירות שנתי למעלית
  monthlyCost Float     @default(0)
  startDate   DateTime
  endDate     DateTime
  notes       String?
  createdAt   DateTime  @default(now())
}

// הודעה לדיירים (לוח מודעות)
model Announcement {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title      String
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// יומן הודעות שנשלחו (מייל/תזכורות) - status: SENT | SIMULATED | FAILED
model Notification {
  id         String   @id @default(cuid())
  residentId String?
  email      String
  type       String   @default("DEBT_REMINDER")
  subject    String
  body       String
  status     String
  error      String?
  createdAt  DateTime @default(now())
}

// הוצאה
model Expense {
  id           String              @id @default(cuid())
  buildingId   String
  building     Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requestId    String?
  request      MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  category     String              @default("OTHER")
  amount       Float
  date         DateTime            @default(now())
  description  String?
  createdAt    DateTime            @default(now())
}
